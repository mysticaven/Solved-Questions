import java.util.*;

public class GCDPairCounter {

    // Count how many elements in arr are divisible by dx
    static int countDivisible(int[] arr, int dx) {
        int cnt = 0;
        for (int val : arr) {
            if (val % dx == 0) cnt++;
        }
        return cnt;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        int mx = 0;
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            mx = Math.max(mx, arr[i]);
        }

        // Step 1: count of numbers divisible by i
        int[] u = new int[mx + 1];
        for (int i = 1; i <= mx; i++) {
            u[i] = countDivisible(arr, i);
        }

        // Step 2: find pairs with exact GCD = i
        long[] g = new long[mx + 1];
        long[] mul = new long[mx + 1];

        for (int i = mx; i >= 2; i--) {
            long x = u[i];
            g[i] = x * (x - 1) / 2; // all pairs divisible by i

            long ans = 0;
            for (int id = 2; i * id <= mx; id++) {
                ans += g[i * id]; // subtract pairs counted for multiples
            }

            mul[i] = g[i] - ans; // pairs with GCD == i
        }

        // Step 3: print results
        for (int i = 2; i <= mx; i++) {
            System.out.print(mul[i] + " ");
        }

        sc.close();
    }
}
